OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API — necessari per al gateway de veu (PWA instal·lador).
# Obtén la clau a https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port del gateway HTTP + WebSocket (per defecte 3001).
GATEWAY_PORT=3001

# Token compartit per protegir el gateway quan s'exposa a Internet. Sense
# aquest valor, /session i /ws són oberts (només accepta-ho en dev local).
# Genera'n un de llarg: `openssl rand -hex 32` o similar.
GATEWAY_ACCESS_TOKEN=

# Origen(s) autoritzat(s) per CORS, separats per comes. Només rellevant
# quan la PWA i el gateway estan en dominis diferents. Amb same-origin
# (producció amb PWA servida pel propi gateway) es pot deixar buit.
# CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Model i thinking level de Gemini Live. Els valors per defecte funcionen.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_THINKING_LEVEL=HIGH
# GEMINI_VOICE=Zephyr

# Debug: 1 imprimeix el kind de cada missatge que arriba de Gemini.
# GATEWAY_DEBUG_GEMINI=0
