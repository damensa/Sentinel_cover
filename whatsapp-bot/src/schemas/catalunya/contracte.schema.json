{
  "$id": "https://sentinel.local/schemas/catalunya/contracte.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contracte_Manteniment_BT_Catalunya",
  "type": "object",
  "required": ["titular", "representant", "installacio", "data"],
  "properties": {
    "titular": {
      "allOf": [
        { "$ref": "../_shared.json#/$defs/Persona" },
        {
          "type": "object",
          "properties": {
            "adreca": { "$ref": "../_shared.json#/$defs/Emplacament" }
          }
        }
      ]
    },
    "representant": {
      "$ref": "../_shared.json#/$defs/Persona",
      "description": "Representant legal si el titular és jurídic. Pot coincidir amb el titular."
    },
    "installacio": {
      "type": "object",
      "required": ["adreca", "us", "potencia_contractada_kw", "tensio"],
      "properties": {
        "adreca": { "$ref": "../_shared.json#/$defs/Emplacament" },
        "us": {
          "type": "string",
          "enum": ["Habitatge", "Local", "Industrial", "Oficines", "Altres"]
        },
        "potencia_max_kw": { "type": "number", "minimum": 0.1, "maximum": 500 },
        "potencia_installada_kw": { "type": "number", "minimum": 0.1, "maximum": 500 },
        "potencia_contractada_kw": { "type": "number", "minimum": 0.1, "maximum": 500 },
        "superficie_m2": { "type": "number", "minimum": 1 },
        "tensio": {
          "type": "string",
          "enum": ["230 V", "3x230/400 V", "Altra"]
        },
        "num_expedient_bt": {
          "type": "string",
          "description": "Ex. 'CAT-2026-01234'."
        },
        "empresa_comercialitzadora": { "type": "string" },
        "aporta_doc": {
          "type": "string",
          "description": "Documentació aportada (text lliure)."
        },
        "altres_dades": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "description": "Data i lloc de signatura. Es pot auto-completar amb avui i la ciutat de l'obra si l'instal·lador no ho diu.",
      "required": ["dia", "mes", "any", "ciutat"],
      "properties": {
        "dia": { "type": "string", "pattern": "^(0?[1-9]|[12][0-9]|3[01])$" },
        "mes": { "type": "string" },
        "any": { "type": "string", "pattern": "^20[0-9]{2}$" },
        "ciutat": { "type": "string" }
      }
    },
    "_confidence": {
      "type": "object",
      "properties": {
        "titular_nom": { "$ref": "../_shared.json#/$defs/Confidence" },
        "titular_nif": { "$ref": "../_shared.json#/$defs/Confidence" },
        "potencia_contractada_kw": { "$ref": "../_shared.json#/$defs/Confidence" },
        "num_expedient_bt": { "$ref": "../_shared.json#/$defs/Confidence" },
        "adreca_installacio": { "$ref": "../_shared.json#/$defs/Confidence" }
      }
    }
  }
}
